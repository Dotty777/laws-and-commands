  "content": "<!-- wp:group {\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:heading {\"level\":1} -->\n<h1 class=\"wp-block-heading\">Instructions research directory</h1>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>The main study is now <a href=\"/instructions/\">Instructions — Laws and Commandments</a>. Use this supporting directory for book-order catalogues, full passage inventories and the original Christ-study collections.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><a href=\"/instructions/\">Read Instructions</a> · <a href=\"/instructions/instructions-index/\">Instructions index</a> · <a href=\"/instructions/beyond-the-torah/\">Beyond the Torah</a> · <a href=\"/bible/law/the-commandments/individual-command-counting-method/\">Counting and classification guide</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:table {\"hasFixedLayout\":false} -->\n<figure class=\"wp-block-table\"><table><thead><tr><th>View</th><th>What it contains</th></tr></thead><tbody><tr><td><a href=\"/instructions/\">Consolidated Instructions</a></td><td>1,223 Torah requirements arranged in 14 topics, with four Christian classifications and original-setting records.</td></tr><tr><td><a href=\"/instructions/instructions-index/\">Instructions Index</a></td><td>The existing Torah requirements, Christ studies and apostolic teachings, with their separate scopes.</td></tr><tr><td><a href=\"/bible/law/the-commandments/individual-command-counting-method/\">Counting and classification guide</a></td><td>Counting rules, textual qualifications, source boundaries and supplements.</td></tr><tr><td><a href=\"/instructions/beyond-the-torah/\">Beyond the Torah</a></td><td>Existing wider collections, twelve additional passage records and the remaining coverage work.</td></tr></tbody></table></figure>\n<!-- /wp:table -->\n<!-- wp:heading {\"level\":2} -->\n<h2 class=\"wp-block-heading\">Read by biblical book</h2>\n<!-- /wp:heading -->\n<!-- wp:table {\"hasFixedLayout\":false} -->\n<figure class=\"wp-block-table\"><table><thead><tr><th>Book</th><th>Individual requirements</th><th>Source passage groups</th></tr></thead><tbody><tr><td>Genesis</td><td><a href=\"/bible/law/the-commandments/genesis-individual-commands/\">Open catalogue</a></td><td><a href=\"/bible/law/the-commandments/genesis-command-inventory/\">Open full passages</a></td></tr><tr><td>Exodus</td><td><a href=\"/bible/law/the-commandments/exodus-individual-commands/\">Open catalogue</a></td><td><a href=\"/bible/law/the-commandments/exodus-command-inventory/\">Open full passages</a></td></tr><tr><td>Leviticus</td><td><a href=\"/bible/law/the-commandments/leviticus-individual-commands/\">Open catalogue</a></td><td><a href=\"/bible/law/the-commandments/leviticus-command-inventory/\">Open full passages</a></td></tr><tr><td>Numbers</td><td><a href=\"/bible/law/the-commandments/numbers-individual-commands/\">Open catalogue</a></td><td><a href=\"/bible/law/the-commandments/numbers-command-inventory/\">Open full passages</a></td></tr><tr><td>Deuteronomy</td><td><a href=\"/bible/law/the-commandments/deuteronomy-individual-commands/\">Open catalogue</a></td><td><a href=\"/bible/law/the-commandments/deuteronomy-command-inventory/\">Open full passages</a></td></tr></tbody></table></figure>\n<!-- /wp:table -->\n<!-- wp:heading {\"level\":2} -->\n<h2 class=\"wp-block-heading\">Christ and apostolic studies</h2>\n<!-- /wp:heading -->\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item --><li><a href=\"/bible/law/the-commandments/christ-the-law-fulfilled/\">The Commandments — The Law Fulfilled</a></li><!-- /wp:list-item --><!-- wp:list-item --><li><a href=\"/bible/law/the-commandments/christ-repent-believe-follow/\">The Commandments — Repent, Believe, Follow</a></li><!-- /wp:list-item --><!-- wp:list-item --><li><a href=\"/bible/law/the-commandments/christ-love-mercy-forgiveness/\">The Commandments — Love, Mercy and Forgiveness</a></li><!-- /wp:list-item --><!-- wp:list-item --><li><a href=\"/bible/law/the-commandments/christ-prayer-fasting-giving/\">The Commandments — Prayer, Fasting and Giving</a></li><!-- /wp:list-item --><!-- wp:list-item --><li><a href=\"/bible/law/the-commandments/christ-treasure-trust-watchfulness/\">The Commandments — Treasure, Trust and Watchfulness</a></li><!-- /wp:list-item --><!-- wp:list-item --><li><a href=\"/bible/law/the-commandments/christ-the-church-and-its-mission/\">The Commandments — The Church and Its Mission</a></li><!-- /wp:list-item --><!-- wp:list-item --><li><a href=\"/bible/discipleship/the-teachings-of-the-apostles/\">Teachings of the Apostles</a></li><!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n<!-- wp:details -->\n<details class=\"wp-block-details\"><summary>Earlier links and section bookmarks</summary><!-- wp:heading {\"level\":3,\"anchor\":\"individual-command-total\"} -->\n<h3 class=\"wp-block-heading\" id=\"individual-command-total\"><a href=\"/instructions/instructions-index/#torah-index\">Individual Command Total</a></h3>\n<!-- /wp:heading -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"torah-inventory\"} -->\n<h3 class=\"wp-block-heading\" id=\"torah-inventory\"><a href=\"/instructions/#coverage\">Torah Inventory</a></h3>\n<!-- /wp:heading -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"reading-method\"} -->\n<h3 class=\"wp-block-heading\" id=\"reading-method\"><a href=\"/instructions/#topics\">Reading Method</a></h3>\n<!-- /wp:heading -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"fulfillment-guide\"} -->\n<h3 class=\"wp-block-heading\" id=\"fulfillment-guide\"><a href=\"/instructions/#classifications\">Fulfillment Guide</a></h3>\n<!-- /wp:heading -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"transformed-guide\"} -->\n<h3 class=\"wp-block-heading\" id=\"transformed-guide\"><a href=\"/instructions/#classifications\">Transformed Guide</a></h3>\n<!-- /wp:heading -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"interpretation-differences\"} -->\n<h3 class=\"wp-block-heading\" id=\"interpretation-differences\"><a href=\"/instructions/#topics\">Interpretation Differences</a></h3>\n<!-- /wp:heading -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"transformed-entries\"} -->\n<h3 class=\"wp-block-heading\" id=\"transformed-entries\"><a href=\"/instructions/instructions-index/\">Transformed Entries</a></h3>\n<!-- /wp:heading -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"reading-marks\"} -->\n<h3 class=\"wp-block-heading\" id=\"reading-marks\"><a href=\"/instructions/#topics\">Reading Marks</a></h3>\n<!-- /wp:heading -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"citation-audit\"} -->\n<h3 class=\"wp-block-heading\" id=\"citation-audit\"><a href=\"/bible/law/the-commandments/individual-command-counting-method/\">Citation Audit</a></h3>\n<!-- /wp:heading -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"part-one\"} -->\n<h3 class=\"wp-block-heading\" id=\"part-one\"><a href=\"/instructions/#topics\">Part One</a></h3>\n<!-- /wp:heading -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"subjects\"} -->\n<h3 class=\"wp-block-heading\" id=\"subjects\"><a href=\"/instructions/#topics\">Subjects</a></h3>\n<!-- /wp:heading -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"all-entries\"} -->\n<h3 class=\"wp-block-heading\" id=\"all-entries\"><a href=\"/instructions/#topics\">All Entries</a></h3>\n<!-- /wp:heading -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"part-two\"} -->\n<h3 class=\"wp-block-heading\" id=\"part-two\"><a href=\"/instructions/instructions-index/#nt-index\">Part Two</a></h3>\n<!-- /wp:heading -->\n</details>\n<!-- /wp:details -->\n</div>\n<!-- /wp:group -->\n"
