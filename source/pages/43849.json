  "content": "<!-- wp:group {\"layout\":{\"type\":\"constrained\",\"contentSize\":\"900px\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"level\":1} -->\n<h1 class=\"wp-block-heading\">Individual Commands — Genesis</h1>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p><a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/the-commandments/#individual-command-total\">Laws and Commandments</a> · <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/the-commandments/individual-command-counting-method/\">Counting method and chapter audit</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><strong>60 requirements first indexed in Genesis.</strong> This book page contains 60 main-catalogue IDs including repeated requirements first indexed in earlier books. Repeated IDs add nothing to the overall total of 1,223. All 50 chapters are accounted for in the chapter audit.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p>Read each command in its original setting. The linked verse ranges preserve the recipients, qualifications and exceptions. The wording below is an editorial summary, not an additional Scripture translation. Historical commands and covenant law are labelled separately.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/the-commandments/genesis-command-inventory/\">Read the full passage inventory for Genesis</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li><a href=\"#commands-chapter-1\">Genesis 1</a></li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li><a href=\"#commands-chapter-2\">Genesis 2</a></li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li><a href=\"#commands-chapter-4\">Genesis 4</a></li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li><a href=\"#commands-chapter-6\">Genesis 6</a></li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li><a href=\"#commands-chapter-8\">Genesis 8</a></li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li><a href=\"#commands-chapter-9\">Genesis 9</a></li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li><a href=\"#commands-chapter-12\">Genesis 12</a></li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li><a href=\"#commands-chapter-13\">Genesis 13</a></li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li><a href=\"#commands-chapter-15\">Genesis 15</a></li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li><a href=\"#commands-chapter-16\">Genesis 16</a></li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li><a href=\"#commands-chapter-17\">Genesis 17</a></li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li><a href=\"#commands-chapter-18\">Genesis 18</a></li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li><a href=\"#commands-chapter-19\">Genesis 19</a></li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li><a href=\"#commands-chapter-21\">Genesis 21</a></li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li><a href=\"#commands-chapter-22\">Genesis 22</a></li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li><a href=\"#commands-chapter-26\">Genesis 26</a></li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li><a href=\"#commands-chapter-28\">Genesis 28</a></li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li><a href=\"#commands-chapter-31\">Genesis 31</a></li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li><a href=\"#commands-chapter-32\">Genesis 32</a></li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li><a href=\"#commands-chapter-35\">Genesis 35</a></li>\n<!-- /wp:list-item -->\n</ul>\n<!-- /wp:list -->\n<!-- wp:heading {\"level\":2,\"anchor\":\"commands-chapter-1\"} -->\n<h2 class=\"wp-block-heading\" id=\"commands-chapter-1\">Genesis 1</h2>\n<!-- /wp:heading -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"command-C0001\"} -->\n<h3 class=\"wp-block-heading\" id=\"command-C0001\">C0001 · Multiply and increase the human family</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p><em>Creation blessing and commission.</em> Counted once in the main catalogue.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><strong>Scripture:</strong> <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-1/#v1-28\">Genesis 1:28</a> · <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-9/#v9-1\">Genesis 9:1</a> · <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-9/#v9-7\">Genesis 9:7</a> · <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-35/#v35-11\">Genesis 35:11</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"command-C0002\"} -->\n<h3 class=\"wp-block-heading\" id=\"command-C0002\">C0002 · Fill the earth</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p><em>Creation blessing and commission.</em> Counted once in the main catalogue.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><strong>Scripture:</strong> <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-1/#v1-28\">Genesis 1:28</a> · <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-9/#v9-1\">Genesis 9:1</a> · <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-9/#v9-7\">Genesis 9:7</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"command-C0003\"} -->\n<h3 class=\"wp-block-heading\" id=\"command-C0003\">C0003 · Subdue the earth</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p><em>Creation blessing and commission.</em> Counted once in the main catalogue.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><strong>Scripture:</strong> <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-1/#v1-28\">Genesis 1:28</a> · <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-9/#v9-1\">Genesis 9:1</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"command-C0004\"} -->\n<h3 class=\"wp-block-heading\" id=\"command-C0004\">C0004 · Rule over the living creatures</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p><em>Creation blessing and commission.</em> Counted once in the main catalogue.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><strong>Scripture:</strong> <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-1/#v1-28\">Genesis 1:28</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":2,\"anchor\":\"commands-chapter-2\"} -->\n<h2 class=\"wp-block-heading\" id=\"commands-chapter-2\">Genesis 2</h2>\n<!-- /wp:heading -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"command-C0005\"} -->\n<h3 class=\"wp-block-heading\" id=\"command-C0005\">C0005 · Tend the garden entrusted to Adam</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p><em>Personal or historical instruction.</em> Counted once in the main catalogue.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><strong>Scripture:</strong> <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-2/#v2-15\">Genesis 2:15</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"command-C0006\"} -->\n<h3 class=\"wp-block-heading\" id=\"command-C0006\">C0006 · Guard the garden entrusted to Adam</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p><em>Personal or historical instruction.</em> Counted once in the main catalogue.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><strong>Scripture:</strong> <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-2/#v2-15\">Genesis 2:15</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"command-C0007\"} -->\n<h3 class=\"wp-block-heading\" id=\"command-C0007\">C0007 · Do not eat from the tree of the knowledge of good and evil</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p><em>Personal or historical instruction.</em> Counted once in the main catalogue.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><strong>Scripture:</strong> <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-2/#v2-17\">Genesis 2:17</a> · <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-3/#v3-3\">Genesis 3:3</a> · <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-3/#v3-11\">Genesis 3:11</a> · <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-3/#v3-17\">Genesis 3:17</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":2,\"anchor\":\"commands-chapter-4\"} -->\n<h2 class=\"wp-block-heading\" id=\"commands-chapter-4\">Genesis 4</h2>\n<!-- /wp:heading -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"command-C0008\"} -->\n<h3 class=\"wp-block-heading\" id=\"command-C0008\">C0008 · Cain: be still in response to God&#x27;s correction</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p><em>Personal or historical instruction.</em> Counted once in the main catalogue.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><strong>Scripture:</strong> <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-4/#v4-7\">Genesis 4:7</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":2,\"anchor\":\"commands-chapter-6\"} -->\n<h2 class=\"wp-block-heading\" id=\"commands-chapter-6\">Genesis 6</h2>\n<!-- /wp:heading -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"command-C0009\"} -->\n<h3 class=\"wp-block-heading\" id=\"command-C0009\">C0009 · Noah: construct the ark to the specified timber, dimensions and storeys</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p><em>Personal or historical instruction.</em> Counted once in the main catalogue.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><strong>Scripture:</strong> <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-6/#v6-14\">Genesis 6:14–16</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"command-C0010\"} -->\n<h3 class=\"wp-block-heading\" id=\"command-C0010\">C0010 · Noah: make compartments in the ark</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p><em>Personal or historical instruction.</em> Counted once in the main catalogue.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><strong>Scripture:</strong> <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-6/#v6-14\">Genesis 6:14–16</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"command-C0011\"} -->\n<h3 class=\"wp-block-heading\" id=\"command-C0011\">C0011 · Noah: coat the ark inside and outside with pitch</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p><em>Personal or historical instruction.</em> Counted once in the main catalogue.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><strong>Scripture:</strong> <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-6/#v6-14\">Genesis 6:14–16</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"command-C0012\"} -->\n<h3 class=\"wp-block-heading\" id=\"command-C0012\">C0012 · Noah: finish the ark&#x27;s upper structure as specified</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p><em>Personal or historical instruction.</em> Counted once in the main catalogue.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><strong>Scripture:</strong> <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-6/#v6-14\">Genesis 6:14–16</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"command-C0013\"} -->\n<h3 class=\"wp-block-heading\" id=\"command-C0013\">C0013 · Noah: put the ark&#x27;s door in its side</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p><em>Personal or historical instruction.</em> Counted once in the main catalogue.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><strong>Scripture:</strong> <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-6/#v6-14\">Genesis 6:14–16</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"command-C0014\"} -->\n<h3 class=\"wp-block-heading\" id=\"command-C0014\">C0014 · Noah: enter the ark with the designated household</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p><em>Personal or historical instruction.</em> Counted once in the main catalogue.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><strong>Scripture:</strong> <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-6/#v6-18\">Genesis 6:18</a> · <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-7/#v7-1\">Genesis 7:1</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"command-C0015\"} -->\n<h3 class=\"wp-block-heading\" id=\"command-C0015\">C0015 · Noah: bring the animals and birds into the ark in the specified numbers and male-female pairs</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p><em>Personal or historical instruction.</em> Counted once in the main catalogue.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><strong>Scripture:</strong> <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-6/#v6-19\">Genesis 6:19–20</a> · <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-7/#v7-2\">Genesis 7:2–3</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"command-C0016\"} -->\n<h3 class=\"wp-block-heading\" id=\"command-C0016\">C0016 · Noah: gather food for the household and animals</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p><em>Personal or historical instruction.</em> Counted once in the main catalogue.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><strong>Scripture:</strong> <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-6/#v6-21\">Genesis 6:21</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":2,\"anchor\":\"commands-chapter-8\"} -->\n<h2 class=\"wp-block-heading\" id=\"commands-chapter-8\">Genesis 8</h2>\n<!-- /wp:heading -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"command-C0017\"} -->\n<h3 class=\"wp-block-heading\" id=\"command-C0017\">C0017 · Noah and household: leave the ark</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p><em>Personal or historical instruction.</em> Counted once in the main catalogue.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><strong>Scripture:</strong> <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-8/#v8-16\">Genesis 8:16</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"command-C0018\"} -->\n<h3 class=\"wp-block-heading\" id=\"command-C0018\">C0018 · Noah: bring the animals out of the ark</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p><em>Personal or historical instruction.</em> Counted once in the main catalogue.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><strong>Scripture:</strong> <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-8/#v8-17\">Genesis 8:17</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":2,\"anchor\":\"commands-chapter-9\"} -->\n<h2 class=\"wp-block-heading\" id=\"commands-chapter-9\">Genesis 9</h2>\n<!-- /wp:heading -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"command-C0019\"} -->\n<h3 class=\"wp-block-heading\" id=\"command-C0019\">C0019 · Do not consume blood in the prohibited forms</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p><em>Community and ethical law.</em> Counted once in the main catalogue.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><strong>Scripture:</strong> <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-9/#v9-4\">Genesis 9:4</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:details -->\n<details class=\"wp-block-details\"><summary>Other passages for this same requirement</summary><!-- wp:paragraph -->\n<p><a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/leviticus/chapter-3/#v3-17\">Leviticus 3:17</a> · <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/leviticus/chapter-7/#v7-26\">Leviticus 7:26–27</a> · <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/leviticus/chapter-17/#v17-10\">Leviticus 17:10–12</a> · <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/leviticus/chapter-17/#v17-14\">Leviticus 17:14</a> · <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/deuteronomy/chapter-12/#v12-16\">Deuteronomy 12:16</a> · <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/deuteronomy/chapter-12/#v12-23\">Deuteronomy 12:23–25</a> · <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/deuteronomy/chapter-15/#v15-23\">Deuteronomy 15:23</a></p>\n<!-- /wp:paragraph -->\n</details>\n<!-- /wp:details -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"command-C0020\"} -->\n<h3 class=\"wp-block-heading\" id=\"command-C0020\">C0020 · Require the killer&#x27;s life for human bloodshed</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p><em>Judicial and property law.</em> Counted once in the main catalogue.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><strong>Scripture:</strong> <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-9/#v9-6\">Genesis 9:6</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:details -->\n<details class=\"wp-block-details\"><summary>Other passages for this same requirement</summary><!-- wp:paragraph -->\n<p><a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/exodus/chapter-21/#v21-12\">Exodus 21:12</a> · <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/leviticus/chapter-24/#v24-17\">Leviticus 24:17</a> · <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/leviticus/chapter-24/#v24-21\">Leviticus 24:21</a> · <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/numbers/chapter-35/#v35-16\">Numbers 35:16–21</a></p>\n<!-- /wp:paragraph -->\n</details>\n<!-- /wp:details -->\n<!-- wp:heading {\"level\":2,\"anchor\":\"commands-chapter-12\"} -->\n<h2 class=\"wp-block-heading\" id=\"commands-chapter-12\">Genesis 12</h2>\n<!-- /wp:heading -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"command-C0021\"} -->\n<h3 class=\"wp-block-heading\" id=\"command-C0021\">C0021 · Abram: leave your country and father&#x27;s household for the land God will show</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p><em>Personal or historical instruction.</em> Counted once in the main catalogue.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><strong>Scripture:</strong> <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-12/#v12-1\">Genesis 12:1</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":2,\"anchor\":\"commands-chapter-13\"} -->\n<h2 class=\"wp-block-heading\" id=\"commands-chapter-13\">Genesis 13</h2>\n<!-- /wp:heading -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"command-C0022\"} -->\n<h3 class=\"wp-block-heading\" id=\"command-C0022\">C0022 · Abram: look across the land in every direction</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p><em>Personal or historical instruction.</em> Counted once in the main catalogue.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><strong>Scripture:</strong> <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-13/#v13-14\">Genesis 13:14</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"command-C0023\"} -->\n<h3 class=\"wp-block-heading\" id=\"command-C0023\">C0023 · Abram: walk through the length and breadth of the land</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p><em>Personal or historical instruction.</em> Counted once in the main catalogue.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><strong>Scripture:</strong> <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-13/#v13-17\">Genesis 13:17</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":2,\"anchor\":\"commands-chapter-15\"} -->\n<h2 class=\"wp-block-heading\" id=\"commands-chapter-15\">Genesis 15</h2>\n<!-- /wp:heading -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"command-C0024\"} -->\n<h3 class=\"wp-block-heading\" id=\"command-C0024\">C0024 · Abram: do not fear God&#x27;s promised future</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p><em>Personal or historical instruction.</em> Counted once in the main catalogue.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><strong>Scripture:</strong> <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-15/#v15-1\">Genesis 15:1</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"command-C0025\"} -->\n<h3 class=\"wp-block-heading\" id=\"command-C0025\">C0025 · Abram: look toward heaven</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p><em>Personal or historical instruction.</em> Counted once in the main catalogue.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p><strong>Scripture:</strong> <a href=\"https://staging-8e0d-waywardnightjars.wpcomstaging.com/bible/law/genesis/chapter-15/#v15-5\">Genesis 15:5</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":3,\"anchor\":\"command-C0026\"} -->\n<h3 class=\"wp-block-heading\" id=\"command-C0026\">C0026 · Abram: attempt to count the stars</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p><em>Personal or historical instruction.</em> Counted once in the main catalogue.</p>\n<!-- /wp: